generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (pgbouncer) — dipakai app saat runtime di serverless
  url       = env("DATABASE_URL")
  // Direct connection — dipakai Prisma untuk migrate/db push
  directUrl = env("DIRECT_URL")
}

model Account {
  id             String          @id @default(cuid())
  name           String          @unique
  colorTag       String
  currentBalance Float           @default(0)
  createdAt      DateTime        @default(now())
  transactions   Transaction[]
  quickShortcuts QuickShortcut[]
}

model Category {
  id             String          @id @default(cuid())
  name           String          @unique
  emoji          String
  iconName       String          @default("circle-dollar-sign")
  type           String
  budgetPeriod   String          @default("WEEKLY")
  dailyBudget    Float?
  weeklyBudget   Float?
  monthlyBudget  Float?
  transactions   Transaction[]
  quickShortcuts QuickShortcut[]
  budgetTargets  BudgetTarget[]
}

model Transaction {
  id               String          @id @default(cuid())
  accountId        String
  categoryId       String?
  amount           Float
  type             String
  description      String          @default("")
  date             DateTime
  linkedTransferId String?
  isCheckin        Boolean         @default(false)
  isPacaran        Boolean         @default(false)
  createdAt        DateTime        @default(now())
  account          Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category         Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  linkedTransfer   Transaction?    @relation("TransferPair", fields: [linkedTransferId], references: [id], onDelete: SetNull)
  linkedFrom       Transaction[]   @relation("TransferPair")

  @@index([accountId])
  @@index([categoryId])
  @@index([date])
  @@index([type])
  @@index([isCheckin])
  @@index([isPacaran])
}

model QuickShortcut {
  id            String   @id @default(cuid())
  label         String
  accountId     String
  categoryId    String
  defaultAmount Float?
  emoji         String   @default("")
  iconName      String   @default("zap")
  usageCount    Int      @default(0)
  createdAt     DateTime @default(now())
  account       Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category      Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([usageCount])
}

model BudgetTarget {
  id            String   @id @default(cuid())
  categoryId    String
  period        String
  targetAmount  Float
  effectiveFrom DateTime @default(now())
  category      Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
}

model AppSettings {
  id                  String    @id @default("default")
  weeklyGeneralBudget Float?
  checkinModeActive   Boolean   @default(false)
  checkinStartedAt    DateTime?
  pacaranModeActive   Boolean   @default(false)
  pacaranStartedAt    DateTime?
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model NotificationPreference {
  id                String    @id @default("default")
  dailyReminder     Boolean   @default(true)
  dailyReminderHour Int       @default(20)
  budgetAlert       Boolean   @default(true)
  weeklySummary     Boolean   @default(true)
  weeklySummaryDay  Int       @default(1)
  weeklySummaryHour Int       @default(9)
  lastDailySent     DateTime?
  lastWeeklySent    DateTime?
  lastBudgetAlerts  String    @default("{}")
}
