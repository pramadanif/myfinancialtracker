# ── Database (Neon Postgres untuk Vercel) ─────────────────────────────
# Ambil dari dashboard Neon / Vercel Storage.
# DATABASE_URL = connection POOLED (ada "-pooler" di host) → dipakai app runtime
# DIRECT_URL   = connection DIRECT (tanpa "-pooler")       → dipakai prisma migrate/db push
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Session encryption secret (generate: openssl rand -base64 32)
SESSION_SECRET="change-this-to-a-random-32-char-secret"

# Single-user PIN (6 digit)
APP_PIN="123456"

# Web Push (generate: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:your@email.com"

# Cron secret untuk notifikasi terjadwal (generate: openssl rand -base64 32)
# Set nilai yang SAMA di Environment Variables Vercel — dipakai Vercel Cron & cron eksternal.
CRON_SECRET=""

# App URL (production: https://nama-app.vercel.app atau domain custom)
APP_URL="http://localhost:3000"

# Timezone untuk notifikasi terjadwal (default: Asia/Jakarta / WIB)
APP_TIMEZONE="Asia/Jakarta"
