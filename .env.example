# Database (SQLite file path)
DATABASE_URL="file:./dev.db"

# Session encryption secret (generate with: openssl rand -base64 32)
SESSION_SECRET="change-this-to-a-random-32-char-secret"

# Single-user PIN (6 digit)
APP_PIN="123456"

# Optional: port (dev=3000, production VPS=3010 — hindari bentrok dengan app lain)
PORT=3000

# Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:your@email.com"

# Cron secret for scheduled notifications (generate with: openssl rand -base64 32)
CRON_SECRET=""

# App URL for cron scripts (production: https://your-domain.com)
APP_URL="http://localhost:3000"
